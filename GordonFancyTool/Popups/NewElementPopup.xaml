<Window x:Class="GordonFancyTool.Popups.NewElementPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GordonFancyTool.Popups"
        mc:Ignorable="d"
        Height="200" Width="250"
        Title="NewElementPopup"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="PopupLoaded"
        Icon="/Assets/AppIcon.ico">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock 
            Text="Enter a name:" 
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="4" />

        <TextBox 
            x:Name="InputTextBox" 
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="4" />

        <Button 
            Content="OK"
            Grid.Row="2"
            Grid.Column="1"
            Margin="4"
            Click="OkClick" />

        <Button 
            Content="Cancel"
            Grid.Row="2"
            Grid.Column="3"
            Margin="4"
            Click="CancelClick" />
    </Grid>
</Window>
