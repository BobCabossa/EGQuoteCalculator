<Window x:Class="GordonFancyTool.Popups.ImportingPopup"
        x:Name="MyControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GordonFancyTool.Popups"
        mc:Ignorable="d"
        Height="150" Width="150"
        Title="Importer Data"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/AppIcon.ico">
    
    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding ActionsDone, ElementName=MyControl}" d:Text="100" />
            <TextBlock Text="/" />
            <TextBlock Text="{Binding ActionsNeeded, ElementName=MyControl}" d:Text="100" />
        </StackPanel>

        <TextBlock x:Name="DoneText" Text="Færdig" HorizontalAlignment="Center" Margin="0,10,0,1" Visibility="Hidden" d:Visibility="Visible" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button
                x:Name="OkButton"
                Content="Ok" 
                MinWidth="50"
                MaxWidth="150"
                Width="auto"
                Click="ClickOk" 
                IsEnabled="False" />
            
            <Button 
                Content="Stop" 
                MinWidth="50"
                MaxWidth="150"
                Width="auto"
                Click="ClickCancel" />
        </StackPanel>
    </Grid>
</Window>
