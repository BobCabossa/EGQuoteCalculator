<UserControl x:Class="GordonFancyTool.Components.ElementsTopRow"
             x:Name="MyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GordonFancyTool.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" TextWrapping="WrapWithOverflow" Margin="3,1,3,1" Text="{Binding Title, ElementName=MyControl}"  />
        <TextBlock Grid.Column="1" TextWrapping="WrapWithOverflow" Margin="3,1,3,1" Text="{Binding Staffing, ElementName=MyControl}"  />
        <TextBlock Grid.Column="2" TextWrapping="WrapWithOverflow" Margin="3,1,3,1" Text="{Binding HourlyRate, ElementName=MyControl}" />
        <local:DoubleTextBox x:Name="Hours" Grid.Column="3" ValueChanged="HourChanged" Grid.Row="1" />
        <TextBlock Grid.Column="4" TextWrapping="WrapWithOverflow" Margin="3,1,3,1" Text="{Binding SocialCost, ElementName=MyControl}" Visibility="{Binding Show, ElementName=MyControl}" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="5" TextWrapping="WrapWithOverflow" Margin="3,1,3,1" Text="{Binding SalaryIncrease, ElementName=MyControl}"  Visibility="{Binding Show, ElementName=MyControl}" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="6" TextWrapping="WrapWithOverflow" Margin="3,1,3,1" Text="{Binding RiskFactor, ElementName=MyControl}"  Visibility="{Binding Show, ElementName=MyControl}" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="7" TextWrapping="WrapWithOverflow" Margin="3,1,3,1" Text="{Binding CompanyProfitPercentage, ElementName=MyControl}" />
        <TextBlock x:Name="Sale" Grid.Column="8" TextWrapping="WrapWithOverflow" Margin="3,1,3,1" />
        <TextBlock x:Name="PercentageOfOffers" Grid.Column="9" TextWrapping="WrapWithOverflow" Margin="3,1,3,1" />
        <TextBlock x:Name="CompanyProfit" Grid.Column="10" TextWrapping="WrapWithOverflow" Margin="3,1,3,1" />
        <TextBlock x:Name="SocialSecurityCosts" Grid.Column="11" TextWrapping="WrapWithOverflow" Margin="3,1,3,1" />
        <TextBlock x:Name="AmountForSalaryIncrease" Grid.Column="12" TextWrapping="WrapWithOverflow" Margin="3,1,3,1" />
        <TextBlock x:Name="AmountForRiskRate" Grid.Column="13" TextWrapping="WrapWithOverflow" Margin="3,1,3,1" />
    </Grid>
</UserControl>
