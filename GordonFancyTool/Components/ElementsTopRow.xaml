<UserControl x:Class="GordonFancyTool.Components.ElementsTopRow"
             x:Name="MyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GordonFancyTool.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition MinWidth="180" />
            <ColumnDefinition />
            <ColumnDefinition MinWidth="175" />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition MinWidth="140" />
            <ColumnDefinition />
            <ColumnDefinition MinWidth="155" />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding Title, ElementName=MyControl}"  />
        <TextBlock Grid.Column="1" Text="{Binding Staffing, ElementName=MyControl}"  />
        <TextBlock Grid.Column="2" Text="{Binding HourlyRate, ElementName=MyControl}" />
        <local:DoubleTextBox Grid.Column="3" ValueChanged="HourChanged" x:Name="Hours" />
        
        <TextBlock 
            Grid.Column="4" 
            Text="{Binding SocialCost, ElementName=MyControl}" 
            Visibility="{Binding Show, ElementName=MyControl}" 
            HorizontalAlignment="Center" />
        
        <TextBlock 
            Grid.Column="5" 
            Text="{Binding SalaryIncrease, ElementName=MyControl}"  
            Visibility="{Binding Show, ElementName=MyControl}" 
            HorizontalAlignment="Center" />
        
        <TextBlock 
            Grid.Column="6" 
            Text="{Binding RiskFactor, ElementName=MyControl}"  
            Visibility="{Binding Show, ElementName=MyControl}" 
            HorizontalAlignment="Center" />
        
        <TextBlock 
            Grid.Column="7" 
            Text="{Binding CompanyProfitPercentage, ElementName=MyControl}" />
        
        <TextBlock Grid.Column="8" x:Name="Sale" />
        <TextBlock Grid.Column="9" x:Name="PercentageOfOffers" />
        <TextBlock Grid.Column="10" x:Name="CompanyProfit" />
        <TextBlock Grid.Column="11" x:Name="SocialSecurityCosts" />
        <TextBlock Grid.Column="12" x:Name="AmountForSalaryIncrease" />
        <TextBlock Grid.Column="13" x:Name="AmountForRiskRate" />
    </Grid>
</UserControl>
