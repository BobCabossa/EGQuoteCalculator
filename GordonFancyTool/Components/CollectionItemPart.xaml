<UserControl x:Class="GordonFancyTool.Components.CollectionItemPart"
             x:Name="MyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GordonFancyTool.Components"
             mc:Ignorable="d" 
             d:DesignHeight="55" d:DesignWidth="800">
    <Border BorderThickness="0,0,0,1">
        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding _data.ProductName, ElementName=MyControl}" Grid.Column="0" d:Text="texting" Margin="2,0" />
            <local:CustomTextBlock Value="{Binding _data.MinToInstall, ElementName=MyControl}" Type="TimeMin" Grid.Column="1" Margin="2,0" />
            <local:DoubleTextBox ValueChanged="ValueUpdated" x:Name="ValueBox" Grid.Column="2" Margin="2,0" />
            <Button Grid.Column="3" Click="RemoveClick" Margin="2,0">Fjen</Button>
        </Grid>
    </Border>
</UserControl>
