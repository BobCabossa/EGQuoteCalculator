<UserControl x:Class="GordonFancyTool.Components.ProjectItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GordonFancyTool.Components"
             mc:Ignorable="d" 
             d:DesignHeight="75" d:DesignWidth="1800"
             d:Background="WhiteSmoke">
    
    <Grid Margin="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="0.75*" />
            <ColumnDefinition Width="0.75*" />
            <ColumnDefinition Width="0.75*" />
        </Grid.ColumnDefinitions>
        
        <TextBlock x:Name="Title" Margin="2" d:Text="A new task, we need to do." />
        <local:CustomTextBlock Grid.Column="1" Type="Currency" x:Name="PriceExclusiveVAT" />
        <local:CustomTextBlock Grid.Column="2" Type="Currency" x:Name="Profit" />
        <local:CustomTextBlock Grid.Column="3" Type="Percentage" x:Name="ContributionMarginRatio" />
        <local:CustomTextBlock Grid.Column="4" Type="NoneStay" x:Name="NormalStaffingTime" />
        <local:CustomTextBlock Grid.Column="5" Type="NoneStay" x:Name="ApprenticeStaffingTime" />
        <Button Click="OpenElementView" Grid.Column="6" Margin="2">Åben</Button>
        <Button Click="EditItem" Grid.Column="7" Margin="2">Redigere</Button>
        <Button Click="DeleteItem" Grid.Column="8" Margin="2">Fjen</Button>
    </Grid>
</UserControl>
