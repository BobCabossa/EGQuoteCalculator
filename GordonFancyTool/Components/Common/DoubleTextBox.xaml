<UserControl x:Class="GordonFancyTool.Components.DoubleTextBox"
             x:Name="MyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GordonFancyTool.Components"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="150"
             d:Background="WhiteSmoke">

    <TextBox x:Name="textBox"
        PreviewTextInput="DoubleTextBox_PreviewTextInput"
        DataObject.Pasting="DoubleTextBox_Pasting"
        TextChanged="TextBox_TextChanged"
        Text="{Binding ValueString, ElementName=MyControl, Mode=TwoWay}" />
</UserControl>
