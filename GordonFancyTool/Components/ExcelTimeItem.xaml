<UserControl x:Class="GordonFancyTool.Components.ExcelTimeItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GordonFancyTool.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:Background="WhiteSmoke">

    <Grid Margin="5,2,5,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        
        <TextBlock x:Name="Title" />
        <local:DoubleTextBox HorizontalAlignment="Right" Grid.Column="2" ValueChanged="TimeUpdated" x:Name="Time" />
    </Grid>
</UserControl>
