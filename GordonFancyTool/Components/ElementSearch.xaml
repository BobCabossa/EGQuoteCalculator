<UserControl x:Class="GordonFancyTool.Components.ElementSearch"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GordonFancyTool.Components"
             mc:Ignorable="d" 
             d:DesignHeight="35" d:DesignWidth="300">

    <Grid>
        <!-- SEARCH BOX -->
        <TextBox x:Name="SearchTextBox"
                 Width="300"
                 Height="35"
                 Padding="8,5"
                 Text="{Binding SearchText,
                                ElementName=root,
                                UpdateSourceTrigger=PropertyChanged}"
                 TextChanged="SearchTextBox_TextChanged" />
        
        <!-- DROPDOWN -->
        <Popup x:Name="SearchPopup"
               IsOpen="{Binding IsDropDownOpen, 
                       ElementName=root}"
               PlacementTarget="{Binding ElementName=SearchTextBox}"
               Placement="Bottom"
               StaysOpen="False">

            <Border Width="300"
                    MaxHeight="250"
                    Background="White"
                    BorderBrush="Gray"
                    BorderThickness="1">

                <ListBox x:Name="ResultsList"
                         ItemsSource="{Binding FilteredItems, ElementName=root}"
                         DisplayMemberPath="ProductName"
                         MouseLeftButtonUp="ResultsList_MouseLeftButtonUp" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
