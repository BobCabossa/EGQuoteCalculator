<UserControl x:Class="GordonFancyTool.Components.ProjectFinalResults"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GordonFancyTool.Components"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800"
             d:Background="WhiteSmoke">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="0.75*" />
            <ColumnDefinition Width="0.75*" />
            <ColumnDefinition Width="0.75*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Row 0 -->
        <TextBlock Margin="2" Text="Samlet elsklusiv moms" />
        <local:CustomTextBlock Grid.Column="1" Type="Currency" x:Name="PriceExclusiveVAT" />
        <local:CustomTextBlock Grid.Column="2" Type="Currency" x:Name="Profit" />
        <local:CustomTextBlock Grid.Column="3" Type="Percentage" x:Name="ContributionMarginRatio" />
        <local:CustomTextBlock Grid.Column="4" Type="NoneStay" x:Name="NormalStaffingTime" />
        <local:CustomTextBlock Grid.Column="5" Type="NoneStay" x:Name="ApprenticeStaffingTime" />

        <!-- Row 1 -->
        <TextBlock Grid.Row="1" Margin="2" Text="Moms: " />
        <local:CustomTextBlock Grid.Row="1" Margin="52,2,2,2" Type="Percentage" x:Name="Vat" />
        <local:CustomTextBlock Grid.Column="1" Grid.Row="1" Type="Currency" x:Name="VatPrice" />
        <local:CustomTextBlock Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="1" HorizontalAlignment="Center" Type="NoneStay" x:Name="TotalStaffingTime" />

        <!-- Row 2 -->
        <TextBlock Grid.Row="2" Margin="2" Text="Samlet inklusiv moms" />
        <local:CustomTextBlock Grid.Column="1" Grid.Row="2" Type="Currency" x:Name="TotalPrice" />
        <TextBlock Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" Margin="2" Text="Antal Dage" HorizontalAlignment="Center" />
    </Grid>
</UserControl>
