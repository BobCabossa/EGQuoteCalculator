<UserControl x:Class="GordonFancyTool.Components.CollectionItem"
             x:Name="MyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GordonFancyTool.Components"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="800"
             d:Background="WhiteSmoke">
    <Border Margin="4" Padding="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="75" MinWidth="50" Width="auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="2" x:Name="CollectionsTitle" d:Text="Some title" Margin="3,3,159,2" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Column="1" Margin="3">
                <Button MinWidth="65" Click="OnChangeTitle" Margin="1,0">Endre navn</Button>
                <Button MinWidth="65" Click="OnRemoveItem" Margin="1,0">Fjern</Button>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1">
                <StackPanel x:Name="Items" />
                <local:ElementSearch
                    Margin="0,5"
                    SearchItems="{Binding Data, ElementName=MyControl}"
                    ValueSelected="AddItem" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
