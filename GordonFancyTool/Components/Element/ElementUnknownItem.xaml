<UserControl x:Class="GordonFancyTool.Components.ElementUnknownItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GordonFancyTool.Components"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="1900"
             d:Background="WhiteSmoke">

    <Border BorderThickness="0,0,0,0.5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="170" />
                <ColumnDefinition />
                <ColumnDefinition  MaxWidth="90"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="2">Ukendt materiale:</TextBlock>
            <TextBlock Grid.Column="1" x:Name="UnknownItemName" d:Text="This is a material used in something." />
            <local:ButtonRemove BtnClicked="RemoveUnknown" Grid.Column="11" />
        </Grid>
    </Border>
</UserControl>
