<UserControl x:Class="GordonFancyTool.Components.ElementCollectionItem"
             x:Name="MyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GordonFancyTool.Components"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="800"
             d:Background="WhiteSmoke">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding ExcelCollection.Name, ElementName=MyControl}" x:Name="Title" Grid.Row="0" Margin="2,2,508,2" d:Text="Title" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="0" Margin="2" x:Name="QuantityChange">
            <TextBlock d:Text="Mængde:" Margin="5,0" />
            <local:DoubleTextBox HorizontalAlignment="Center" />
        </StackPanel>
        <Button Click="RemoveClick" x:Name="RemoveButton" HorizontalAlignment="Right" Content="Fjern" Margin="2" MinWidth="75" />
        <StackPanel Margin="30,0,0,0" x:Name="Items" Grid.Row="1" />
    </Grid>
</UserControl>
