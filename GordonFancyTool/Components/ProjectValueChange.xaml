<UserControl x:Class="GordonFancyTool.Components.ProjectValueChange"
             x:Name="MyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GordonFancyTool.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="ComponentLoaded">
    <Grid MaxHeight="75">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding Title, ElementName=MyControl}" />
        <local:DoubleTextBox Grid.Column="4" Margin="1" ValueChanged="ValueUpdated" x:Name="ValueBox" />
    </Grid>
</UserControl>
