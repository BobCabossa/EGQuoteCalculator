<UserControl x:Class="GordonFancyTool.Components.ProjectValueChange"
             x:Name="MyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GordonFancyTool.Components"
             mc:Ignorable="d" 
             d:DesignHeight="75" d:DesignWidth="800"
             Loaded="ComponentLoaded"
             d:Background="WhiteSmoke">

    <Grid MaxHeight="75" Margin="5,2,5,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding Title, ElementName=MyControl}" d:Text="Best title of 2026! i can find something else." />
        <local:DoubleTextBox Grid.Column="1" HorizontalAlignment="Right" Margin="1" ValueChanged="ValueUpdated" x:Name="ValueBox" />
    </Grid>
</UserControl>
