<UserControl x:Class="GordonFancyTool.Components.ElementFinalResults"
             x:Name="MyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GordonFancyTool.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition MinWidth="65" MaxWidth="100" />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">Total samlet pris for bemanding</TextBlock>
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">Total samlet pris for material</TextBlock>
        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">Total samlet transport, energi , emballagebidrag og affald</TextBlock>
        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">Total tilbud eksklusiv moms</TextBlock>

        <TextBlock Grid.Row="3" Grid.Column="2">Total tilbud eksklusiv moms</TextBlock>

        <local:CustomTextBlock Grid.Row="0" Grid.Column="3" x:Name="TotalPriceForStaffing" Type="Currency" />
        <local:CustomTextBlock Grid.Row="1" Grid.Column="3" x:Name="TotalPriceForMaterial" Type="Currency" />
        <local:CustomTextBlock Grid.Row="2" Grid.Column="3" x:Name="TotalPriceForFixedPrices" Type="Currency" />
        <local:CustomTextBlock Grid.Row="3" Grid.Column="3" x:Name="TotalPriceExclusiveVAT" Type="Currency" />

        <local:CustomTextBlock Grid.Row="0" Grid.Column="4" x:Name="StaffingContributionsPercentage" Type="Percentage" />
        <local:CustomTextBlock Grid.Row="1" Grid.Column="4" x:Name="MaterialContributionsPercentage" Type="Percentage" />
        <local:CustomTextBlock Grid.Row="2" Grid.Column="4" x:Name="FixedPricesContributionsPercentage" Type="Percentage" />
        <local:CustomTextBlock Grid.Row="3" Grid.Column="4" x:Name="TotalPercentage" Type="Percentage" />

        <TextBlock Grid.Row="4" Grid.Column="1">Moms</TextBlock>
        <TextBlock x:Name="VATValue" Grid.Row="4" Grid.Column="2" />
        <local:CustomTextBlock Grid.Row="4" Grid.Column="3" x:Name="VAT" Type="Currency" />

        <TextBlock Grid.Row="5" Grid.Column="2">Total pris inklusiv moms :</TextBlock>
        <local:CustomTextBlock Grid.Row="5" Grid.Column="3" x:Name="FullPrice" Type="Currency" />
    </Grid>
</UserControl>
