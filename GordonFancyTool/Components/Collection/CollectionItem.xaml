<UserControl x:Class="GordonFancyTool.Components.CollectionItem"
             x:Name="MyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GordonFancyTool.Components"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="800"
             d:Background="WhiteSmoke">
    
    <Border Margin="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="75" MinWidth="50" Width="auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="2" x:Name="CollectionsTitle" d:Text="Some title" Margin="3,3,159,3" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Column="1" Margin="3">
                <local:ButtonEdit MinWidth="65" BtnClicked="OnChangeTitle" Margin="1,0" Text="Endre navn" />
                <local:ButtonRemove MinWidth="65" BtnClicked="OnRemoveItem" Margin="1,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1">
                <StackPanel x:Name="Items" />
                <local:ElementSearch
                    x:Name="SearchBar"
                    Margin="0,5"
                    ValueSelected="AddItem" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
