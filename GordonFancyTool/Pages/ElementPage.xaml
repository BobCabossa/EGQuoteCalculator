<Page x:Class="GordonFancyTool.Pages.ElementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GordonFancyTool.Components"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="ElementPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Button Click="BackToProject" Margin="3">Tilbage</Button>

        <!-- Element name -->
        <Grid Grid.Column="1" Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Background="Red" FontSize="30" VerticalAlignment="Center" Grid.Column="0">Project:</TextBlock>
            <TextBlock x:Name="ElemetName" FontSize="30" VerticalAlignment="Center" Grid.Column="1">None</TextBlock>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Margin="3">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <local:ElementsTopRow 
                        Grid.Row="1" 
                        Grid.ColumnSpan="14" 
                        Title="B1.1"
                        Staffing="Elektriker-Faglært"
                        HourlyRate="225"
                        SocialCost="58"
                        SalaryIncrease="3"
                        RiskFactor="10"
                        CompanyProfitPercentage="39,033"
                        Show="Hidden"
                    />

                    <local:ElementsTopRow 
                        Grid.Row="2" 
                        Grid.ColumnSpan="14" 
                        Title="B1.1"
                        Staffing="Elektriker-Lærling"
                        HourlyRate="136"
                        SocialCost="58"
                        SalaryIncrease="3"
                        RiskFactor="10"
                        CompanyProfitPercentage="60,19"
                        Show="Show"
                    />
                    <local:ElementsTopRow 
                        Grid.Row="3" 
                        Grid.ColumnSpan="14" 
                        Title="B1.1"
                        Staffing="Elektriker-Lærling Voksen +25år"
                        HourlyRate="146,9"
                        SocialCost="58"
                        SalaryIncrease="3"
                        RiskFactor="10"
                        CompanyProfitPercentage="48,305"
                        Show="Hidden"
                    />

                    <Grid Grid.Row="4" Grid.ColumnSpan="14" Background="Yellow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="350*"/>
                            <ColumnDefinition Width="140*"/>
                            <ColumnDefinition Width="350*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="150*"/>
                            <ColumnDefinition Width="700"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" HorizontalAlignment="Right" Margin="3,0,3,0">Bemanding samlet</TextBlock>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Margin="3,0,3,0">3</TextBlock>
                        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="3,0,3,0">timer</TextBlock>
                        <TextBlock Grid.Column="3" HorizontalAlignment="Right" Margin="3,0,3,0">Bemanding salg</TextBlock>
                        <TextBlock Grid.Column="4" HorizontalAlignment="Right" Margin="3,0,3,0">950</TextBlock>
                        <TextBlock Grid.Column="5" HorizontalAlignment="Left" Margin="3,0,3,0">kr</TextBlock>
                    </Grid>
                </Grid>

                <Button Content="Button 1"
                Height="100"
                Margin="10"/>

                <Button Content="Button 2"
                Height="100"
                Margin="10"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
