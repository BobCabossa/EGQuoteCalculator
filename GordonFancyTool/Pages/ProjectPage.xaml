<Page x:Class="GordonFancyTool.Pages.ProjectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GordonFancyTool.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="ProjectPage"
      Loaded="PageLoaded"
      d:Background="WhiteSmoke">

    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Grid.RowSpan="2">
            <Button Click="ImportData" Margin="4" MinHeight="65">Importere Data</Button>
            <Button Click="OpenEditProjectValues" Margin="4" MinHeight="65">Redigere Project Data</Button>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="1" Margin="5">
            <StackPanel>
                <Grid x:Name="items">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Button x:Name="AddElementButton" Click="AddElement" Margin="2">Tilføj</Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
