<Page x:Class="GordonFancyTool.Pages.ProjectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GordonFancyTool.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="ProjectPage"
      Loaded="PageLoaded">

    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Button Click="AddExcelData" Grid.Row="0" Margin="4">Add Excel data</Button>
        <Button Click="OpenEditProjectValues" Grid.Row="1" Margin="4">Redigere project data</Button>
        
        <Grid x:Name="items" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Button x:Name="AddElementButton" Click="AddElement" Margin="2">Add</Button>
        </Grid>
    </Grid>
</Page>
